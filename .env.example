# DataChart 환경변수 예시 — 실제 값 채워서 시스템 환경변수에 등록 (이 파일은 git 커밋 X)
#
# 등록 방법: Windows → 시작 → "환경 변수" 검색 → "사용자 변수"에 추가

# ── KRX OpenAPI (선택, 무료) ────────────────────────────────────────
# 발급: https://openapi.krx.co.kr
# 가입 후 마이페이지에서 KOSPI/KOSDAQ/KRX 시리즈 일별시세 서비스 신청·승인 필요
KRX_API_KEY=your_krx_api_token_here

# ── KIS Developers (선택, 무료) ─────────────────────────────────────
# 발급: https://apiportal.koreainvestment.com (한국투자증권 계좌 필요)
# 시세 조회만 쓰면 수수료 0원
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ENV=real         # real(실전) 또는 mock(모의)

# 모의·실전 동시 보유 시 (선택):
# KIS_REAL_APP_KEY=...
# KIS_REAL_APP_SECRET=...
# KIS_MOCK_APP_KEY=...
# KIS_MOCK_APP_SECRET=...
